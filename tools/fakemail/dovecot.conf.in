# テスト用 IMAP サーバー (Dovecot 2.4)。run.sh が @DIR@ などを置き換えて使う。
dovecot_config_version = 2.4.0
dovecot_storage_version = 2.4.0

# UNIX ソケットのパス長制限 (108 バイト) に収まるよう、短いパスを使う。
base_dir = @RUN@
state_dir = @DIR@/state
log_path = @DIR@/dovecot.log
default_internal_user = @USER@
default_internal_group = @GROUP@
default_login_user = @USER@

protocols = imap
listen = 127.0.0.1
ssl = no
auth_allow_cleartext = yes
auth_mechanisms = plain login

passdb static {
  password = @PASSWORD@
}
userdb static {
  fields {
    uid = @UID@
    gid = @GID@
    home = @DIR@/home
  }
}

mail_driver = maildir
mail_path = @DIR@/home/Maildir

namespace inbox {
  inbox = yes
  separator = /
  mailbox Sent {
    special_use = \Sent
    auto = create
  }
}

service imap-login {
  # root でないので chroot できない。
  chroot =
  inet_listener imap {
    port = @IMAP_PORT@
  }
  inet_listener imaps {
    port = 0
  }
}
service imap {
  vsz_limit = 1G
}
